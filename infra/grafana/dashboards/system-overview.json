{
  "id": null,
  "uid": "system-overview",
  "title": "Microservices System Overview",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "tags": ["microservices", "infra", "prometheus"],
  "panels": [
    {
      "type": "stat",
      "title": "Prometheus status",
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 },
      "targets": [
        {
          "expr": "up{job=\"prometheus\"}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["last"], "values": false },
        "orientation": "horizontal"
      }
    },
    {
      "type": "stat",
      "title": "Nginx status",
      "id": 2,
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 4 },
      "targets": [
        {
          "expr": "up{job=\"nginx\"}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["last"], "values": false },
        "orientation": "horizontal"
      }
    },
    {
      "type": "stat",
      "title": "Application services UP",
      "id": 3,
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 },
      "targets": [
        {
          "expr": "sum(up{job=~\"auth-service|orders-service|orders-history-service\"})",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["last"], "values": false },
        "orientation": "horizontal"
      }
    },
    {
      "type": "timeseries",
      "title": "Prometheus scrape duration",
      "id": 4,
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "scrape_duration_seconds",
          "refId": "A"
        }
      ]
    }
  ]
}