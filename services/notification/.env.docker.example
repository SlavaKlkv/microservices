# Значения для запуска в docker compose.
DB_HOST=postgres-notifications
DB_PORT=5432
DB_USER=app
DB_PASSWORD=change-me
DB_NAME=notification_db

LOG_LEVEL=INFO
METRICS_PORT=9100

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID=notification
KAFKA_GROUP_ID=notification

OUTBOX_POLL_INTERVAL_SEC=1.0
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10
# Retention: отправленные строки outbox и отметки об обработанных событиях
# удаляются воркером; 0 отключает уборку
OUTBOX_RETENTION_DAYS=7
PROCESSED_EVENT_RETENTION_DAYS=30
OUTBOX_CLEANUP_INTERVAL_SEC=3600

CONSUMER_MAX_ATTEMPTS=5
CONSUMER_BACKOFF_BASE_SEC=0.5
CONSUMER_BACKOFF_CAP_SEC=30.0

# Реальная отправка писем выключена: с включённой сервис будет ждать SMTP.
NOTIFICATION_ENABLED=false
NOTIFICATION_FAIL_RATE=0.0
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=change-me
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=false

REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
IDEMPOTENCY_TTL_SEC=86400
