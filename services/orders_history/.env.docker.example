# Значения для запуска в docker compose.
DB_HOST=postgres-history
DB_PORT=5432
DB_USER=app
DB_PASSWORD=change-me
DB_NAME=orders_history_db

LOG_LEVEL=INFO
METRICS_PORT=9100

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID=orders-history
KAFKA_GROUP_ID=orders-history

CONSUMER_MAX_ATTEMPTS=5
CONSUMER_BACKOFF_BASE_SEC=0.5
CONSUMER_BACKOFF_CAP_SEC=30.0

REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
IDEMPOTENCY_TTL_SEC=86400
